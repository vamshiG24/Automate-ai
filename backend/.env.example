# Copy this file to .env and fill in real values. Never commit or share .env.
# Generate random secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

PORT=8000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/automate_ai?retryWrites=true&w=majority
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Login session JWT (at least 32 characters, use the command above)
JWT_SECRET=your_64_char_random_hex
# Signs the OAuth "state" parameter for Google / Instagram connect
OAUTH_STATE_SECRET=your_64_char_random_hex
# AES-256-GCM key for stored OAuth tokens (exactly 64 hex characters)
ENCRYPTION_KEY=your_64_char_random_hex
# Shared secret between the backend and the MCP server process
AUTOMATE_MCP_SECRET=your_64_char_random_hex

# AI models
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
GOOGLE_API_KEY=your_google_gemini_api_key
GEMINI_VISION_MODEL=gemini-2.5-flash
# Web search for agents (free key at https://tavily.com)
TAVILY_API_KEY=your_tavily_api_key

# Google OAuth (Gmail + Calendar)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback

# Instagram via Facebook Login for Business (each user connects their own account)
INSTAGRAM_APP_ID=your_meta_app_id
INSTAGRAM_APP_SECRET=your_meta_app_secret
INSTAGRAM_CONFIG_ID=your_login_configuration_id
INSTAGRAM_GRAPH_VERSION=v23.0
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/integrations/instagram/callback

# Razorpay (use rzp_test_ keys for demos)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
# No Razorpay account? true = demo checkout that adds credits without real
# money. Only works when NODE_ENV is not "production" and Razorpay keys are not set.
PAYMENTS_DEMO_MODE=false

# Credits charged for one normal chat message
CHAT_CREDIT_COST=5
